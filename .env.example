# ===========================================
# GenCode/灵码ADE — 环境变量模板
# 复制此文件为 .env 按需修改:
#   cp .env.example .env
# ===========================================

# --- 开发服务器 ---
# 设为 0.0.0.0 可在局域网访问 dev server（默认仅 localhost）
# TAURI_DEV_HOST=0.0.0.0

# --- Rust 日志级别（开发调试用） ---
# 可选: error, warn, info, debug, trace
# RUST_LOG=gencode_lib=debug

# --- AI API 密钥 ---
# GenCode 采用 BYOK（自带密钥）模式，可在软件界面中配置。
# 密钥存储在 OS 原生密钥链中，无需在此填写。
# 支持的提供商: OpenAI, Anthropic, Google, xAI, DeepSeek, 通义千问等
